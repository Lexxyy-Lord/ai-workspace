NODE_ENV=production
APP_NAME="AI Workspace"
PUBLIC_FRONTEND_URL=http://apps1.vynzzhost.com:25664

API_HOST=0.0.0.0
API_PORT=25664
SINGLE_PORT_MODE=true
FRONTEND_DIST_DIR=../frontend/out
CORS_ORIGINS=http://apps1.vynzzhost.com:25664
TRUST_PROXY=false
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

DATA_DIR=./data
DATABASE_PATH=./data/ai-workspace.sqlite
WORKSPACE_ROOT=./data/workspaces
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=100

JWT_ACCESS_SECRET=replace-with-random-string-at-least-thirty-two-chars
JWT_REFRESH_SECRET=replace-with-another-random-string-thirty-two-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_SALT_ROUNDS=12
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=change-this-admin-password
ADMIN_NAME=Administrator

DEFAULT_AI_PROVIDER=freemodel
DEFAULT_AI_MODEL=gpt-4o-mini
DEFAULT_AI_TEMPERATURE=0.7
DEFAULT_AI_TOP_P=1
DEFAULT_AI_MAX_TOKENS=2048
DEFAULT_SYSTEM_PROMPT="You are AI Workspace, a professional coding assistant."

FREEMODEL_API_KEY=put-your-freemodel-key-here
FREEMODEL_BASE_URL=https://freemodel.dev/v1
FREEMODEL_CHAT_PATH=/chat/completions
FREEMODEL_MODELS_PATH=/models
FREEMODEL_AUTH_HEADER=Authorization
FREEMODEL_AUTH_PREFIX=Bearer
FREEMODEL_EXTRA_HEADERS={}
PROVIDER_TIMEOUT_MS=60000

NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SOCKET_URL=
