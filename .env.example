# Server
NODE_ENV=development
APP_NAME="AI Workspace"
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=*
LOG_LEVEL=info

# freeemodel.dev provider
# Masukkan API key asli di file .env lokal, jangan commit file .env ke GitHub.
FREEEMODEL_API_KEY=your_freeemodel_api_key_here
FREEEMODEL_BASE_URL=https://freeemodel.dev/api/v1
FREEEMODEL_CHAT_PATH=/chat/completions
FREEEMODEL_MODELS_PATH=/models
FREEEMODEL_MODEL=freeemodel-default
FREEEMODEL_TIMEOUT_MS=60000

# Fleksibel jika provider memakai header selain Authorization: Bearer <key>
FREEEMODEL_AUTH_HEADER=Authorization
FREEEMODEL_AUTH_PREFIX=Bearer
FREEEMODEL_EXTRA_HEADERS={}

# Default generation settings
AI_DEFAULT_TEMPERATURE=0.7
AI_DEFAULT_MAX_TOKENS=1024
AI_SYSTEM_PROMPT="You are a helpful, concise AI assistant."

# UI
PUBLIC_APP_TITLE="AI Workspace"
PUBLIC_APP_DESCRIPTION="Workspace AI berbasis Node.js yang aman karena API key hanya disimpan di server."
