{
  "name": "@ai-workspace/backend",
  "version": "0.2.0",
  "description": "AI Workspace backend API, websocket, authentication, workspace, and AI provider engine.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --env-file=../.env --watch src/server.js",
    "start": "node --env-file=../.env src/server.js",
    "db:migrate": "node --env-file=../.env src/database/migrate.js",
    "db:seed": "node --env-file=../.env src/database/seed.js",
    "lint": "eslint .",
    "test": "node --env-file=../.env --test"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^2.1.35",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.0.9",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0"
  }
}
