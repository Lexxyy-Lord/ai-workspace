{
  "name": "ai-workspace",
  "version": "0.2.0",
  "description": "Production-ready AI Workspace inspired by Claude Code, Cursor, Windsurf, Open WebUI, and VS Code Explorer.",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace backend",
    "start:frontend": "npm run start --workspace frontend",
    "start:pm2": "pm2-runtime ecosystem.config.cjs",
    "lint": "npm run lint --workspace backend && npm run lint --workspace frontend",
    "format": "prettier --write .",
    "test": "npm run test --workspace backend",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:seed": "npm run db:seed --workspace backend"
  },
  "keywords": [
    "ai",
    "workspace",
    "claude-code",
    "cursor",
    "windsurf",
    "open-webui",
    "vscode-explorer",
    "freemodel"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "pm2": "^5.4.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.4.2"
  }
}
